# ==============================================================================
# CV BUILDER - CONFIGURATION TEMPLATE
# ==============================================================================

# Database MongoDB (stocare CV-uri)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=cv-db

# Database MySQL (utilizatori și autentificare)
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=parola

# Inteligență Artificială (Groq / OpenAI API)
# Poți folosi OPENAI_API_KEY, AI_API_KEY sau GROQ_API_KEY
AI_API_KEY=gsk_your_groq_or_openai_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=groq/compound

# Autentificare JWT
JWT_SECRET=your_256_bit_secret_key_here
JWT_EXPIRATION_MS=86400000
