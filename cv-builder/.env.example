# Configurație server
SERVER_PORT=8080

# Baza de date MongoDB (stocare CV-uri)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=cv-db

# Baza de date MySQL (utilizatori și autentificare)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cv_builder_users_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=parola

# Inteligență Artificială (Groq / OpenAI API)
AI_API_KEY=gsk_your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=groq/compound

# Autentificare JWT
JWT_SECRET=your_256_bit_hex_or_base64_secret_key_here
JWT_EXPIRATION_MS=86400000

